{
  "mode": "auto",
  "sprite": "pi-my-project",
  "remoteCwd": "/workspace/my-project",
  "tokenEnv": "SPRITES_TOKEN",
  "toolActivation": "auto",
  "checkpoint": {
    "mode": "risky"
  },
  "bootstrap": {
    "repository": "git@github.com:example/my-project.git",
    "branch": "main",
    "commands": ["npm ci"],
    "services": [
      {
        "name": "web",
        "cmd": "npm",
        "args": ["run", "dev"],
        "dir": "/workspace/my-project",
        "httpPort": 3000
      }
    ],
    "checkpoint": true
  },
  "policy": {
    "network": { "rules": [{ "include": "defaults" }] },
    "privileges": { "profile": "standard", "noNewPrivileges": true },
    "resources": { "memory": { "limitMB": 2048, "autoscale": true } }
  },
  "ci": { "command": "npm test", "namePrefix": "pi-ci", "cleanup": "never" },
  "workers": {
    "count": 2,
    "namePrefix": "pi-worker",
    "agentCommand": "pi -p --no-session",
    "cleanup": "never"
  },
  "rpcHost": {
    "port": 43120,
    "localPort": 43120,
    "piCommand": "pi",
    "secretEnv": "PI_SPRITES_RPC_SECRET"
  }
}
